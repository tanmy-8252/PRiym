DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres"
PG_POOL_MAX="1"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://127.0.0.1:3000"
AUDIT_SECRET="replace-with-another-random-secret-at-least-32-characters"
INSTITUTION_DOMAINS="atria.edu,atria.edu.in"
STORAGE_PROVIDER="local"
UPLOAD_DIR=".data/uploads"
# Required when STORAGE_PROVIDER=supabase; bucket must be private.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="priym-evidence"
# ClamAV path; production uploads fail closed if this is not set.
CLAMSCAN_PATH=""
# Used only by the demo seed. Never seed demo users in production.
SEED_DEMO="true"
DEMO_PASSWORD="PriymDemo1!"
DEMO_TOTP_SECRET="replace-with-a-locally-generated-base32-secret"
NEXT_PUBLIC_DEMO_MODE="true"
# Protect the maintenance endpoint; invoke hourly with Authorization: Bearer.
CRON_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Local development: messages written privately to MAIL_DIR. Production: resend.
EMAIL_PROVIDER="file"
EMAIL_FROM=""
RESEND_API_KEY=""
MAIL_DIR=".data/mail"
REPORT_DIR=".data/reports"
