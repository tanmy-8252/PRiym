{
  "name": "priym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:http": "playwright test tests/e2e/api.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:local": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "setup": "bash scripts/setup.sh",
    "demo:otp": "tsx scripts/demo-otp.ts",
    "db:embedded": "node scripts/embedded-db.mjs start",
    "db:embedded:stop": "node scripts/embedded-db.mjs stop",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "audit:verify": "tsx scripts/verify-audit.ts",
    "mail:inbox": "tsx scripts/mail-inbox.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "demo:reset": "node scripts/create-env.mjs && tsx scripts/demo-reset.ts",
    "test:login": "playwright test tests/e2e/login-api.spec.ts"
  },
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "dependencies": {
    "@next/env": "^16.3.8",
    "@otplib/core": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "2.117.2",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.5",
    "exceljs": "4.4.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "type": "module"
}
