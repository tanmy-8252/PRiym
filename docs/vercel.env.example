# Add these in Vercel Project > Settings > Environment Variables.
# Scope production credentials to Production only. Preview requires a separate DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional direct PostgreSQL URL for migrations (never a prisma:// URL).
DIRECT_URL=""
PG_POOL_MAX="5"
AUTH_SECRET="GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
AUDIT_SECRET="GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
CRON_SECRET="GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
AUTH_URL="https://YOUR_PROJECT_DOMAIN.vercel.app"
INSTITUTION_DOMAINS="atria.edu,atria.edu.in"
SEED_DEMO="false"
NEXT_PUBLIC_DEMO_MODE="false"
# Optional email service; required before registration/reset emails can be sent.
EMAIL_PROVIDER="resend"
EMAIL_FROM=""
RESEND_API_KEY=""
# Configure private storage and an external scanning/upload workflow before
# accepting evidence on Vercel. The existing local ClamAV adapter fails closed.
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="priym-evidence"
CLAMSCAN_PATH=""
