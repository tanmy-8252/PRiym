# Add these in Vercel Project > Settings > Environment Variables.
# Scope production credentials to Production only. Preview requires a separate DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional direct PostgreSQL URL for migrations (never a prisma:// URL).
DIRECT_URL=""
PG_POOL_MAX="5"
AUTH_SECRET="GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
AUDIT_SECRET="GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
CRON_SECRET="GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
AUTH_URL="https://YOUR_PROJECT_DOMAIN.vercel.app"
INSTITUTION_DOMAINS="atria.edu,atria.edu.in"
SEED_DEMO="false"
NEXT_PUBLIC_DEMO_MODE="false"
# Email service is required before production registration opens.
# For Gmail: bare EMAIL_FROM address must equal SMTP_USER.
EMAIL_PROVIDER="smtp"
EMAIL_FROM=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Alternative: EMAIL_PROVIDER=resend with a verified EMAIL_FROM and API key.
RESEND_API_KEY=""
# One-time first Admin provisioning: add only when ready to create the account.
# Production only. Remove ALL BOOTSTRAP_ADMIN_* settings after successful setup.
# BOOTSTRAP_ADMIN_ENABLED="true"
# BOOTSTRAP_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
# BOOTSTRAP_ADMIN_NAME="YOUR_FULL_NAME"
# BOOTSTRAP_ADMIN_PASSWORD="YOUR_NEW_UNIQUE_STRONG_PRIYM_PASSWORD"
# BOOTSTRAP_ADMIN_MFA_SECRET="YOUR_PRIVATELY_ENROLLED_BASE32_SECRET"
# Configure private storage and an external scanning/upload workflow before
# accepting evidence on Vercel. The existing local ClamAV adapter fails closed.
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="priym-evidence"
CLAMSCAN_PATH=""
