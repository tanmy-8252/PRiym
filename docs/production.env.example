# Private operator file, separate from the local demo .env.
# Copy to .env.operator in the repository root. Never commit that file.
# Values must match the deployed Vercel Production environment EXACTLY.
DATABASE_URL="REPLACE_WITH_HOSTED_POSTGRESQL_URL_WITH_SSLMODE_REQUIRE"
AUTH_URL="https://YOUR_PROJECT_DOMAIN.vercel.app"
AUTH_SECRET="REPLACE_WITH_EXISTING_VERCEL_AUTH_SECRET"
AUDIT_SECRET="REPLACE_WITH_EXISTING_VERCEL_AUDIT_SECRET"
PG_POOL_MAX="1"
SEED_DEMO="false"
NEXT_PUBLIC_DEMO_MODE="false"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="YOUR_GMAIL_ADDRESS"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="YOUR_GMAIL_ADDRESS"
SMTP_PASSWORD="REPLACE_WITH_GOOGLE_APP_PASSWORD_WITHOUT_SPACES"
STORAGE_PROVIDER="supabase"
SUPABASE_URL="REPLACE_WITH_PROJECT_URL"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_PRIVATE_SERVICE_KEY"
SUPABASE_STORAGE_BUCKET="priym-evidence"
MALWARE_SCANNER="scanii"
SCANII_API_KEY="REPLACE_WITH_PRIVATE_SCANNER_KEY"
SCANII_API_SECRET="REPLACE_WITH_PRIVATE_SCANNER_SECRET"
SCANII_REGION="ap2"
# Alternative: MALWARE_SCANNER=cloudmersive with its private API key.
CLOUDMERSIVE_API_KEY=""
BOOTSTRAP_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
BOOTSTRAP_ADMIN_NAME=""
# Bootstrap privately asks for a new Admin password and enrolls MFA.
# Do not put the Admin password or MFA secret in this file.
